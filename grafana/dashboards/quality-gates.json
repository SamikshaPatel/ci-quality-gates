              "type": "string"
            },
            {
              "selector": "reason",
              "text": "Reason",
              "type": "string"
            },
            {
              "selector": "minutes",
              "text": "Minutes",
              "type": "number"
            },
            {
              "selector": "run",
              "text": "Run",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
